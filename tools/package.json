{
  "name": "camer-vendor",
  "private": true,
  "description": "Build-time only: bundles CodeMirror 6 into web/vendor/. Not needed to build or run Camer \u2014 the bundle is committed.",
  "scripts": {
    "build": "esbuild cm6-entry.js --bundle --format=iife --global-name=CM --minify --legal-comments=none --target=es2020 --outfile=../web/vendor/codemirror.js",
    "test": "node editor-test.mjs",
    "fonts": "cd .. && python3 tools/vendor-fonts.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "1.2.3",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
